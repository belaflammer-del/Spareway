# --- Supabase (Pflicht) ---------------------------------------------------
# Projekt-URL und anon key: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig (Stripe-Webhook, Wartungsjobs). Niemals im Client verwenden!
SUPABASE_SERVICE_ROLE_KEY=

# Öffentliche Basis-URL der App (für Links in E-Mails, Angebotslinks, Passwort-Reset)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (vorbereitet, optional) ----------------------------------------
# Ohne diese Werte ist die Abrechnung deaktiviert; es werden KEINE Zahlungen ausgeführt.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=

# --- Tests ----------------------------------------------------------------
# Lokale PostgreSQL-Datenbank für die RLS-/Mandantentests (wird bei jedem Lauf neu erstellt!)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/detailflow_test

# --- E-Mail-Versand (vorbereitet, optional) ---------------------------------
# Ohne diese Werte erscheinen Antworten nur im Kundenportal.
RESEND_API_KEY=
MAIL_FROM="Premium Detailing <info@deine-domain.de>"
