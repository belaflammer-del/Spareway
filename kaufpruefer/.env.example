# ─────────────────────────────────────────────────────────────
# Kaufklar – Umgebungsvariablen
# Ohne jeden Schlüssel läuft die App vollständig im gekennzeichneten
# Demo-/Lokalmodus (lokale Datei-Datenbank unter ./.data, Regel-Analyse).
# Geheime Schlüssel NIEMALS mit NEXT_PUBLIC_ präfixen.
# ─────────────────────────────────────────────────────────────

# Öffentliche Basis-URL (für Stripe-Redirects, E-Mail-Links, PDF)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session-Signatur für den lokalen Modus (mind. 32 Zeichen, zufällig)
APP_SECRET=change-me-to-a-long-random-string-with-32-plus-chars

# Kommagetrennte E-Mail-Adressen mit Admin-Zugriff (/admin)
ADMIN_EMAILS=

# ── KI (optional) ────────────────────────────────────────────
# Ohne Schlüssel: regelbasierte Analyse ohne Bild-/Texterkennung.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Multimodales Modell (Text + Bild, strukturierte Ausgaben)
OPENAI_MODEL=gpt-5
# Kosten pro 1 Mio. Tokens in USD – nur für die Kostenstatistik im Admin
OPENAI_COST_INPUT_PER_MTOK=1.25
OPENAI_COST_OUTPUT_PER_MTOK=10

# ── Supabase (optional, empfohlen für Produktion) ───────────
# Ohne Supabase wird eine lokale JSON-Datenbank (.data/db.json) genutzt –
# nur für Entwicklung/Demo, NICHT für Produktion.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig! Wird für Wallet-Buchungen (RPC) und Admin-Statistiken verwendet.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# ── Stripe (optional, Testmodus) ─────────────────────────────
# Nur Test-Schlüssel (sk_test_…). Live-Schlüssel werden abgewiesen,
# solange STRIPE_ALLOW_LIVE nicht explizit "true" ist.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false
# Kostenlose Test-Gutschriften (nur ohne Stripe; in Produktion standardmäßig aus)
# Leer = in Entwicklung erlaubt, in Produktion aus. "true" erzwingt, "false" verbietet.
ALLOW_TEST_CREDITS=

# ── Plattform-Schnittstellen (optional) ─────────────────────
# eBay Browse API (offizielle Schnittstelle, OAuth Client Credentials)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_DE
# mobile.de / AutoScout24: nur mit Partnervertrag – Adapter vorbereitet
MOBILE_DE_API_USER=
MOBILE_DE_API_PASSWORD=
AUTOSCOUT24_API_KEY=

# ── Marktdaten (optional) ────────────────────────────────────
# Generische HTTP-Schnittstelle zu einem lizenzierten Marktdatenanbieter
# (Vertrag siehe docs/INTEGRATIONEN.md). Ohne: kein Marktwert, außer
# der Nutzer hinterlegt selbst gefundene Vergleichsangebote.
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=

# ── Fahrzeughistorie (optional, nur mit kommerzieller Vereinbarung) ─
VEHICLE_HISTORY_PROVIDER=demo
VEHICLE_HISTORY_API_URL=
VEHICLE_HISTORY_API_KEY=

# ── Datenschutz / Betrieb ────────────────────────────────────
# Automatische Löschung hochgeladener Dateien (Stunden)
UPLOAD_RETENTION_HOURS=24
# Geheimnis für /api/cron/cleanup (Authorization: Bearer …)
CRON_SECRET=
# Kostenloser Schnellcheck: max. Anzahl pro Tag
QUICKCHECK_LIMIT_PER_IP=5
QUICKCHECK_LIMIT_PER_USER=10
# Videoanalyse
VIDEO_MAX_SECONDS=90
VIDEO_MAX_MB=100
